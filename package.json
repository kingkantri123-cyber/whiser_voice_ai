{
  "name": "voice-ordering-agent-poc",
  "version": "0.1.0",
  "description": "MVP: text-based tool-calling ordering agent (menu, cart, tools) before the voice layer is added",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "agent": "node src/livekitAgent.js start",
    "agent:dev": "node --watch src/livekitAgent.js dev",
    "test:conversation": "node src/scripts/scriptedConversation.js"
  },
  "dependencies": {
    "@google/genai": "^0.3.1",
    "@livekit/agents": "^1.7.1",
    "@livekit/agents-plugin-deepgram": "^1.7.1",
    "@livekit/agents-plugin-openai": "^1.7.1",
    "@livekit/agents-plugin-silero": "^1.7.1",
    "@livekit/protocol": "^1.50.4",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "groq-sdk": "^1.5.0",
    "livekit-client": "^2.22.1",
    "livekit-server-sdk": "^2.18.0",
    "multer": "^2.2.0",
    "nanoid": "^5.1.16"
  }
}
